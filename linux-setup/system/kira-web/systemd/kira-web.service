[Unit]
Description=Kira web tools (SearXNG + fetch) docker compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/kira-web
ExecStart=/usr/bin/docker compose -f /opt/kira-web/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /opt/kira-web/docker-compose.yml down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
