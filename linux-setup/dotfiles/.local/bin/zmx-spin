#!/bin/zsh
# zmx-spin: watcher that animates kitty tab titles for zmx sessions where
# claude is working (claude-style spinner frames), and marks finished ones
# with "⦿ " - rendered as a red ✳ by the kitty tab template - until the tab
# is actually looked at. Runs as a systemd user service.
#
# Why this exists: zmx parses and drops the inner shell's title/bell escapes,
# so claude's native animated title can never reach the kitty tab bar from
# inside a session. The only signal that crosses zmx is the output stream.
#
# Busy detection: sum of write-bytes (/proc/<pid>/io wchar) of every claude
# process descended from the session's shell. Measured on this machine:
# idle claude (cursor blink, agents UI) ~250 B/s, working claude (its own
# spinner animation alone) >=1400 B/s. Threshold: 600 B/s.
#
# Compute diet: /proc reads are pure zsh (no forks). Process discovery,
# zmx ls and kitten @ ls run at most once per second; animation frames
# (kitten set-tab-title, one per busy tab) at 4 fps. With nothing busy the
# loop idles at 1 Hz, with no kitty sockets at all it just sleeps.
ZMX="$HOME/.local/bin/zmx"
[[ -x "$ZMX" ]] || ZMX="$(command -v zmx)"
KITTEN=/usr/bin/kitten
TITLES=$HOME/.local/state/zmx/titles
RATE=600              # busy threshold, output bytes per second
frames=("✳" "✢" "✶" "✻")

typeset -A shellof sessof prevw state above below lasttitle
rows=""
tick=0
anybusy=0
lastsleep=1

refresh_heavy() {
    # session name <- shell pid
    shellof=()
    while read -r n p; do
        [[ -n "$n" ]] && shellof[$p]=$n
    done <<< "$($ZMX ls 2>/dev/null | awk '
        !/ended=/ {
            n = ""; p = ""
            for (i = 1; i <= NF; i++) {
                split($i, kv, "=")
                if (kv[1] == "name") n = kv[2]
                if (kv[1] == "pid")  p = kv[2]
            }
            if (n != "" && p != "") print n, p
        }')"

    # claude pid -> session, by walking ancestors (sub-claudes of the agents
    # dashboard land in the same tab). Pure /proc, only pgrep forks.
    sessof=()
    local cpid a s
    for cpid in $(pgrep -x claude 2>/dev/null); do
        a=$cpid
        for _ in 1 2 3 4 5; do
            s=$(</proc/$a/stat) 2>/dev/null || break
            a=${${(z)${s##*) }}[2]}   # ppid: 2nd field after the (comm)
            [[ -z "$a" || "$a" == 1 ]] && break
            if [[ -n "${shellof[$a]}" ]]; then sessof[$cpid]=${shellof[$a]}; break; fi
        done
    done

    # kitty tabs backed by zmx sessions: sock, window id, focus, session
    rows=""
    local sock
    for sock in /tmp/kitty-sock-*(N=); do
        rows+="$($KITTEN @ --to "unix:$sock" ls 2>/dev/null | jq -r --arg s "$sock" '
            .[] | .is_focused as $of | .tabs[] | .is_focused as $tf
            | .windows[] | . as $w
            | (($w.foreground_processes // [])[0].cmdline // []) as $c
            | select(($c[0] // "" | endswith("zmx")) and (($c[1] // "") == "attach"))
            | [$s, $w.id, $of, $tf, ($c[2] // "")] | @tsv')"$'\n'
    done
}

while true; do
    (( tick++ ))

    if [[ -z "$(echo /tmp/kitty-sock-*(N=))" ]]; then
        sleep 2; continue
    fi

    # heavy discovery: 1 Hz while animating, every idle cycle otherwise
    if (( anybusy == 0 )) || (( tick % 4 == 1 )); then
        refresh_heavy
    fi

    # accumulate output bytes per session (pure zsh, fork-free)
    typeset -A wsum=()
    for cpid in ${(k)sessof}; do
        io=$(</proc/$cpid/io) 2>/dev/null || continue
        w=${${io#*wchar: }%%$'\n'*}
        (( wsum[${sessof[$cpid]}] += ${w:-0} ))
    done

    # busy threshold scaled to how long we actually slept
    step=$(( RATE * lastsleep ))
    anybusy=0
    for name in ${(v)shellof}; do
        w=${wsum[$name]:-}
        if [[ -z "$w" ]]; then
            state[$name]=none; unset "prevw[$name]"; continue
        fi
        d=$(( w - ${prevw[$name]:-$w} ))
        prevw[$name]=$w
        if (( d > step )); then
            (( above[$name]++ )); below[$name]=0
            # a strong burst flips immediately, a weak one needs two ticks
            if (( d > step * 3 || above[$name] >= 2 )); then
                state[$name]=busy
            fi
        else
            (( below[$name]++ )); above[$name]=0
            if [[ "${state[$name]}" == busy ]] && (( below[$name] >= 4 )); then
                state[$name]=done
            fi
        fi
        [[ "${state[$name]}" == busy ]] && anybusy=1
    done

    while IFS=$'\t' read -r sock wid of tf name; do
        [[ -z "$name" ]] && continue
        s=${state[$name]:-none}
        # marker is cleared only when the tab is genuinely on screen
        if [[ "$s" == done && "$of" == true && "$tf" == true ]]; then
            state[$name]=seen; s=seen
        fi
        title=$(<"$TITLES/$name") 2>/dev/null
        title=${title:-$name}
        case $s in
            busy) t="${frames[$(( tick % 4 + 1 ))]} $title" ;;
            done) t="⦿ $title" ;;
            *)    t="$title" ;;
        esac
        key="$sock:$wid"
        if [[ "${lasttitle[$key]}" != "$t" ]]; then
            $KITTEN @ --to "unix:$sock" set-tab-title --match "id:$wid" "$t" 2>/dev/null
            lasttitle[$key]=$t
        fi
    done <<< "$rows"

    if (( anybusy )); then lastsleep=0.25; sleep 0.25; else lastsleep=1; sleep 1; fi
done
