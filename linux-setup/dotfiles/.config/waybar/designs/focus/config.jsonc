{
    "position": "top",
    "height": 27,
    "modules-left": ["ext/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["hyprland/language", "pulseaudio", "network", "battery", "custom/notif"],

    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-name": true,
        "format-icons": {
            "active": "●",
            "default": "•"
        }
    },

    "clock": {
        "timezone": "Europe/Moscow",
        "format": "{:%H:%M}",
        "format-alt": "{:%A %d %B}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "interval": 2,
        "states": { "warning": 30, "low": 15, "critical": 5 },
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-discharging": "{icon}",
        "format-full": "{icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "tooltip-format": "{capacity}% {timeTo}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{volume}%",
        "scroll-step": 5,
        "on-click": "~/.config/waybar/volume-popup.py"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false,
        "on-click": "~/.config/waybar/wifi-menu.sh"
    },

    "hyprland/language": {
        "format": "{short}"
    },

    "custom/notif": {
        "format": "󰂜",
        "on-click": "swaync-client -t -sw"
    }
}
