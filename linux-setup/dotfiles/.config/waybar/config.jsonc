{
    "position": "top",
    "height": 35,
    "modules-left": ["ext/workspaces", "custom/usage"],
    "modules-center": ["group/island"],
    "modules-right": ["image#cat", "image#ram", "hyprland/language", "pulseaudio", "network", "battery", "custom/notif"],

    "ext/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "sort-by-name": true,
        "format-icons": {
            "active": "●",
            "default": "•"
        }
    },

    "clock": {
        "timezone": "Europe/Moscow",
        "format": "{:%H:%M}",
        "format-alt": "{:%A %d %B}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "battery": {
        "interval": 2,
        "states": { "warning": 30, "low": 15, "critical": 5 },
        "format": "{icon}",
        "format-charging": "{icon}",
        "format-discharging": "{icon}",
        "format-full": "{icon}",
        "format-icons": {
            "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
            "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
        },
        "tooltip-format": "{capacity}% {timeTo}"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{volume}%",
        "scroll-step": 5,
        "on-click": "~/.config/waybar/volume-popup.py"
    },

    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰤭",
        "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
        "tooltip": false,
        "on-click": "~/.config/waybar/wifi-menu.sh"
    },

    "hyprland/language": {
        "format": "{short}"
    },

    "custom/notif": {
        "format": "󰂜",
        "on-click": "swaync-client -t -sw"
    },

    "group/island": {
        "orientation": "horizontal",
        "modules": ["custom/island-ev", "custom/island-clock"]
    },

    "custom/island-ev": {
        "exec": "uv run --script ~/.config/waybar/island.py",
        "return-type": "json",
        "format": "{}",
        "tooltip": false
    },

    "custom/island-clock": {
        "exec": "cat ~/.cache/island/clock.json",
        "return-type": "json",
        "interval": 3600,
        "signal": 10,
        "format": "{}",
        "on-click": "uv run --script ~/.config/waybar/island.py menu",
        "on-click-right": "mkdir -p ~/.cache/island && touch ~/.cache/island/showdate",
        "tooltip": true
    },

    "image#cat": {
        "exec": "cat ~/.cache/runcat/cat.txt",
        "interval": 1,
        "signal": 8,
        "size": 28,
        "tooltip": true
    },

    "image#ram": {
        "exec": "uv run --script ~/.config/waybar/elephant.py",
        "interval": 5,
        "size": 28,
        "tooltip": true
    },

    "custom/usage": {
        "exec": "uv run --script ~/.config/waybar/usage.py",
        "return-type": "json",
        "interval": 120,
        "format": "{}",
        "tooltip": true
    }
}
